[worldserver]

# Root produced by TrinityCore's mapextractor. It must contain dbc/<locale> and gt.
# Forward slashes avoid escaping problems on Windows.
RetailSystems.ClientDataDir = "C:/Games/World of Warcraft/_retail_"

# Challenge Mode / Mythic+
RetailSystems.MythicPlus.CountdownSeconds = 10
RetailSystems.MythicPlus.MaxKeyLevel = 50
RetailSystems.MythicPlus.MapHistoryLimit = 100
RetailSystems.MythicPlus.LeaderboardLimit = 100
RetailSystems.MythicPlus.GuildMembersRequired = 3

# Leave both at zero to select the newest season from current DB2/game-event data.
RetailSystems.MythicPlus.DisplaySeason = 0
RetailSystems.MythicPlus.MythicSeason = 0

# BattlePay is deliberately opt-in. Populate the custom world catalog and grant
# an account balance before enabling it.
RetailSystems.BattlePay.Enabled = 0
RetailSystems.BattlePay.CurrencyID = 34
RetailSystems.BattlePay.CatalogShopLicenseID = 1156753
# Optional capture-backed 12.x catalog generated by tools/extract_capture_catalog.py.
RetailSystems.BattlePay.CaptureFile = ""
RetailSystems.BattlePay.WalletName = "Battle Coins"
# 1 = 12.x shop2 UI (retail shop2 variables are sent; its catalog is loaded by the client from Blizzard
#     web services with the SSO token). 0 = shop2 disabled, the client falls back to the BattlePay store.
RetailSystems.BattlePay.Shop2 = 1

# World quests from `retail_world_quest` (captured retail set): world states, quest timers,
# auto-added task quests inside their quest_poi areas and cycle resets.
RetailSystems.WorldQuests.Enabled = 1

# SMSG_ENCOUNTER_START / SMSG_ENCOUNTER_END at the pull and the end of every dungeon boss (Lua ENCOUNTER_START /
# ENCOUNTER_END, boss segments of damage meters), with SMSG_INSTANCE_ENCOUNTER_UPDATE_ALLOW_RELEASE_IN_PROGRESS before
# the start. Checked byte for byte against a 12.1.5.70688 sniff. Like retail, five-player dungeons outside Mythic+ then
# get no SMSG_INSTANCE_ENCOUNTER_START/END (combat resurrection charges).
RetailSystems.EncounterPackets.Enabled = 1

# "New player restricted" bit of the character list (account wide, set for new accounts on retail); it limits level
# boosts and class trials on the character screen. The tutorial itself follows the per character restriction sent
# with the list (below level 10 on Exile's Reach).
# 0 - never, 1 - accounts whose characters are all below level 10 (default), 2 - always
RetailSystems.NewPlayerExperience.RestrictedAccount = 1

# Accept a client build that has a `build_info` row but no `build_auth_key` row for its platform: the auth
# session digest (which needs that key) is not checked. The session key still comes from the battle.net login.
RetailSystems.Auth.SkipMissingBuildAuthKey = 0

# Combat log packets always carry the caster/target log data (health, attack power, powers), as on retail 12.1.5. Without it
# the 12.x client crashes on combat log entries during a boss encounter (SMSG_ENCOUNTER_START).
RetailSystems.CombatLog.AlwaysSendLogData = 1
