[worldserver]

# Root produced by TrinityCore's mapextractor. It must contain dbc/<locale> and gt.
# Forward slashes avoid escaping problems on Windows.
RetailSystems.ClientDataDir = "C:/Games/World of Warcraft/_retail_"

# Challenge Mode / Mythic+
RetailSystems.MythicPlus.CountdownSeconds = 10
RetailSystems.MythicPlus.MaxKeyLevel = 50
RetailSystems.MythicPlus.MapHistoryLimit = 100
RetailSystems.MythicPlus.LeaderboardLimit = 100
RetailSystems.MythicPlus.GuildMembersRequired = 3

# Leave both at zero to select the newest season from current DB2/game-event data.
RetailSystems.MythicPlus.DisplaySeason = 0
RetailSystems.MythicPlus.MythicSeason = 0

# BattlePay is deliberately opt-in. Populate the custom world catalog and grant
# an account balance before enabling it.
RetailSystems.BattlePay.Enabled = 0
RetailSystems.BattlePay.CurrencyID = 34
RetailSystems.BattlePay.CatalogShopLicenseID = 1156753
# Optional capture-backed 12.x catalog generated by tools/extract_capture_catalog.py.
RetailSystems.BattlePay.CaptureFile = ""
RetailSystems.BattlePay.WalletName = "Battle Coins"
